# Database
DATABASE_PATH=./data/whatsapp.db

# Scheduler (24-hour format)
REMINDER_HOUR=10
REMINDER_MINUTE=0
WEEKLY_SUMMARY_DAY=1

# Logging
LOG_LEVEL=info

# Rate limiting (ms between messages)
MESSAGE_DELAY=1000

# Server (for OAuth and webhooks)
SERVER_PORT=3000
SERVER_BASE_URL=http://localhost:3000

# Mercado Pago OAuth
MP_CLIENT_ID=your_client_id
MP_CLIENT_SECRET=your_client_secret
MP_REDIRECT_URI=http://localhost:3000/oauth/callback
